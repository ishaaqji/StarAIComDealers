# Star AI Platform V1 — environment configuration
# Copy to .env and fill in production values before deploy

# ===== APP =====
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ===== DATABASE (PostgreSQL 15+ with pgvector) =====
DATABASE_URL=postgresql://starai:starai_dev@localhost:5432/star_ai
DB_HOST=localhost
DB_PORT=5432
DB_USER=starai
DB_PASSWORD=starai_dev
DB_NAME=star_ai

# ===== REDIS (BullMQ) =====
REDIS_URL=redis://localhost:6379

# ===== JWT =====
JWT_SECRET=replace-with-a-strong-random-secret
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ===== FILE STORAGE (S3-compatible / MinIO) =====
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=star-ai
MINIO_USE_SSL=false

# ===== AI PROVIDERS =====
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=1536

# ===== WOOCOMMERCE (V1 connector) =====
WOOCOMMERCE_CONSUMER_KEY=wc_...
WOOCOMMERCE_CONSUMER_SECRET=cs_...
WOOCOMMERCE_STORE_URL=https://example.com

# ===== SECURITY =====
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
